{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dhihm/malgwi/schema/lesson-v1.schema.json",
  "title": "lesson-v1",
  "description": "Static study-page lesson document. The model authors only pronunciation_ko and translation_ko; original text and timecodes are bound to the capture via source_digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "video",
    "source_digest",
    "lines"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "video_id",
        "source_language"
      ],
      "properties": {
        "provider": {
          "const": "youtube"
        },
        "video_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "source_language": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "description": "Omitted means embed: in-page IFrame playback with line sync. sheet renders the lines standalone with timestamp links out to the video.",
      "properties": {
        "mode": {
          "enum": [
            "embed",
            "sheet"
          ]
        }
      }
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hex over the canonical JSON of the captured caption list [{start_ms,end_ms,text}...]."
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_ms",
          "end_ms",
          "original",
          "pronunciation_ko",
          "translation_ko"
        ],
        "properties": {
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "original": {
            "type": "string",
            "minLength": 1
          },
          "pronunciation_ko": {
            "type": "string",
            "minLength": 1
          },
          "translation_ko": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "glossary": {
      "type": "array",
      "description": "Optional model-authored Korean glosses for normalized lowercase words or short phrases; usage examples are derived from the lines at display time.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word",
          "meaning_ko"
        ],
        "properties": {
          "word": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9'’-]*( [a-z0-9'’-]+){0,3}$"
          },
          "meaning_ko": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
